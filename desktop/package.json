{
  "name": "biller",
  "productName": "Biller",
  "version": "1.0.0",
  "description": "Biller: quotation & invoice generator for Langoor Media LLP",
  "author": "Langoor Media LLP",
  "private": true,
  "main": "main.js",
  "scripts": {
    "copy-web": "node copy-web.js",
    "start": "npm run copy-web && electron .",
    "dist": "npm run copy-web && rm -rf build/icon-out && mkdir -p build/icon-out && npm run icon && electron-builder --mac dmg --arm64",
    "icon": "DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer xcrun actool \"$PWD/build/Biller.icon\" --compile \"$PWD/build/icon-out\" --platform macosx --minimum-deployment-target 12.0 --app-icon Biller --output-partial-info-plist \"$PWD/build/icon-out/partial.plist\" > /dev/null && test -f build/icon-out/Assets.car && test -f build/icon-out/Biller.icns"
  },
  "devDependencies": {
    "electron": "^45.5.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.langoormedia.biller",
    "productName": "Biller",
    "copyright": "\u00a9 Langoor Media LLP",
    "files": [
      "main.js",
      "web/**/*"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "mac": {
      "icon": "build/icon-out/Biller.icns",
      "category": "public.app-category.business",
      "identity": "-",
      "hardenedRuntime": false,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "extendInfo": {
        "CFBundleIconName": "Biller"
      },
      "extraResources": [
        {
          "from": "build/icon-out/Assets.car",
          "to": "Assets.car"
        }
      ]
    },
    "dmg": {
      "title": "Biller",
      "artifactName": "Biller.dmg",
      "background": "build/dmg-background.png",
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 140,
          "y": 190
        },
        {
          "x": 400,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
